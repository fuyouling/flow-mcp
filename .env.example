# ── Chrome 配置 ────────────────────────────────────────────
CHROME_USER_DATA_DIR=./chrome_data
CHROME_PROFILE_DIRECTORY=Default
CHROME_BINARY_PATH=
CHROME_DOWNLOAD_DIR=./downloads
BROWSER_CONFIG_PATH=./browser_config.yaml

# ── Google Flow ─────────────────────────────────────────────
GOOGLE_FLOW_BASE_URL=https://flow.google.com

# ── Master 节点配置 ─────────────────────────────────────────
MASTER_HOST=0.0.0.0
MASTER_HTTP_PORT=8765
MASTER_GRPC_PORT=50051
MASTER_ASSET_DIR=./data/assets
DB_PATH=./data/flow_mcp.db

# ── Worker 节点配置（Worker 机器上填写）──────────────────────
MASTER_HTTP_URL=http://127.0.0.1:8765
MASTER_GRPC_TARGET=127.0.0.1:50051
WORKER_ID=worker_1
WORKER_ACCOUNT=

# ── 日志 ────────────────────────────────────────────────────
LOG_LEVEL=INFO
